# Variables para el bot automatico en Binance Futures TESTNET (demo, $0 real).
# Copia este archivo a .env y completa con tus keys de testnet.
# OBTIENE KEYS EN: https://testnet.binancefuture.com (usa tu cuenta de Binance normal).
#
# SEGURIDAD: .env esta en .gitignore. NUNCA subas tus keys al repo.
# En Streamlit Cloud usa Settings > Secrets; en GitHub Actions usa Settings > Secrets.

# Modo seguro: true = solo simula (no envia ordenes). false = ejecuta en demo.
DRY_RUN=true

# Keys de TESTNET (NO las de produccion/binance.com real).
BINANCE_TESTNET_API_KEY=tu_api_key_de_testnet_aqui
BINANCE_TESTNET_API_SECRET=tu_api_secret_de_testnet_aqui
